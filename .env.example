# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL decides whether logins work on more than one computer.
#
#   postgresql://…   ONE shared database. A password created on any computer
#                    works on every computer. Use this for anything real.
#   file:./dev.db    a SQLite file on THIS computer only. Accounts created
#                    against it exist nowhere else. Offline development only.
#
# npm run dev / build / db:push all follow this automatically — you only
# change this line.
#
# AUTH_SECRET signs sign-in cookies. Every server running OptiVault must use
# the SAME value or users get signed out moving between them. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-me-see-above"
APP_URL="http://localhost:3000"
CRON_SECRET="dev-cron-secret"

# Messaging (optional — without these, messages are logged and WhatsApp uses click-to-chat links)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_CLOUD_PHONE_ID=""

# Subscription billing (optional — without these, checkout runs in sandbox mode)
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
STRIPE_SECRET_KEY=""

# Local demo only: lets the billing page activate plans without a payment gateway. Never enable in production.
ALLOW_SANDBOX_BILLING="false"

# ── Platform owner (MG Advisory) ──────────────────────────────────────────────
# The dedicated account that administers every client at /platform/login.
# Change the password here and re-run `npm run db:seed`, or change it in the
# console under Activity log → Change your console password.
PLATFORM_OWNER_NAME="MG Advisory"
PLATFORM_OWNER_EMAIL="owner@mgadvisory.co.zw"
# Leave blank and the seed generates a strong one-off password and prints it once.
# Set it only if you want to choose the password yourself.
PLATFORM_OWNER_PASSWORD=""

# Local single-machine demos only: lets a production build run against a file:
# database. NEVER set this on a deployed server.
# ALLOW_UNSAFE_ENV="true"
