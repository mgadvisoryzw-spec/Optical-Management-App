DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string-in-production-0123456789"
APP_URL="http://localhost:3000"
CRON_SECRET="dev-cron-secret"

# Messaging (optional — without these, messages are logged and WhatsApp uses click-to-chat links)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_CLOUD_PHONE_ID=""

# Subscription billing (optional — without these, checkout runs in sandbox mode)
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
STRIPE_SECRET_KEY=""

# Local demo only: lets the billing page activate plans without a payment gateway. Never enable in production.
ALLOW_SANDBOX_BILLING="false"
